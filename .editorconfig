root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,c,cc,cxx}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{md,txt}]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

[*.sln]
end_of_line = crlf
